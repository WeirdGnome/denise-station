msgid "Copies the ROM files (and rom.key) from a folder, e.g. Amiga Forever's Shared/rom, into Amiberry's roms folder."
msgstr "Kopiert die ROM-Dateien (und rom.key) aus einem Ordner, z. B. Shared/rom von Amiga Forever, in den roms-Ordner von Amiberry."

msgid "Choose the folder with the Kickstart ROMs (e.g. Amiga Forever → Shared → rom)"
msgstr "Wähle den Ordner mit den Kickstart-ROMs (z. B. Amiga Forever → Shared → rom)"

msgid "Copied {n} file(s) to {path} ({same} were already there).\n\nIf Amiberry does not find them, open its menu (F12) and press \"Rescan ROMs\" on the Play page (First-run setup)."
msgstr "{n} Datei(en) nach {path} kopiert ({same} waren schon da).\n\nFalls Amiberry sie nicht findet, öffne sein Menü (F12) und drücke auf der Seite Play (First-run setup) auf \"Rescan ROMs\"."

msgid "No Kickstart ROM files found in {path}."
msgstr "Keine Kickstart-ROM-Dateien in {path} gefunden."

msgid "Open Amiberry"
msgstr "Amiberry öffnen"

msgid "Downloading WHDLoad boot files, controllers and shaders…"
msgstr "Lade WHDLoad-Startdateien, Controller und Shader herunter…"

msgid "Amiberry was installed, but the extra files (WHDLoad boot files, controllers, shaders) could not be downloaded: {err}"
msgstr "Amiberry wurde installiert, aber die zusätzlichen Dateien (WHDLoad-Startdateien, Controller, Shader) konnten nicht geladen werden: {err}"

msgid "WHDLoad is not installed yet"
msgstr "WHDLoad ist noch nicht installiert"

msgid "WHDLoad games need the WHDLoad program (from whdload.de), which Amiberry downloads separately. Download it now?"
msgstr "WHDLoad-Spiele brauchen das Programm WHDLoad (von whdload.de), das Amiberry separat herunterlädt. Jetzt herunterladen?"

